generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Profile{
  id Int @id @default(autoincrement())
  name String 
  description String
  links String?
  skills Skills[]
  experience Experience[]
  projects Projects[]
}

model Skills {
  id Int @id @default(autoincrement())
  name String
  profileId Int
  profile Profile? @relation(fields: [profileId], references: [id])
}

model Experience{
  id Int @id @default(autoincrement())
  company String
  position String
  period String?
  achievements String?
  profileId Int
  profile Profile? @relation(fields: [profileId], references: [id])
}


model Projects{
  id Int @id @default(autoincrement())
  name String
  link String?
  profileId Int
  profile Profile? @relation(fields: [profileId], references: [id])
}